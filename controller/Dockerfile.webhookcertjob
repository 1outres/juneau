# syntax=docker/dockerfile:1
# Build the webhookcertjob binary
FROM --platform=$BUILDPLATFORM docker.io/golang:1.24 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum

# Cache dependencies before copying the full source tree.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

# Copy the Go source
COPY cmd/webhookcertjob/main.go cmd/webhookcertjob/main.go

# Build the binary for the target platform.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -o webhookcertjob cmd/webhookcertjob/main.go

# Use distroless as minimal base image to package the webhookcertjob binary.
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/webhookcertjob .
USER 65532:65532

ENTRYPOINT ["/webhookcertjob"]
